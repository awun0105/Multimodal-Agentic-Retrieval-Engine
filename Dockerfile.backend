FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock* ./
RUN uv pip install --system -e . || uv pip install --system fastapi "uvicorn[standard]" pydantic-settings

COPY backend ./backend

ENV PYTHONPATH=/app/backend
EXPOSE 8000

CMD ["uvicorn", "aic_retrieval.main:app", "--host", "0.0.0.0", "--port", "8000"]
