{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase01_checkpoint_state_v2",
  "title": "Phase01 Per-Video Checkpoint State",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "video_id",
    "config_hash",
    "status",
    "stages",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "phase01_checkpoint_state_v2"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "complete",
        "failed_retryable",
        "failed_terminal"
      ]
    },
    "stages": {
      "type": "object",
      "required": [
        "shots",
        "keyframes",
        "asr",
        "ocr",
        "shot_captions",
        "shot_transcript_links",
        "scenes",
        "scene_transcript_links",
        "scene_summaries",
        "package",
        "sync"
      ],
      "properties": {
        "shots": {"$ref": "#/$defs/stage"},
        "keyframes": {"$ref": "#/$defs/stage"},
        "asr": {"$ref": "#/$defs/stage"},
        "ocr": {"$ref": "#/$defs/stage"},
        "shot_captions": {"$ref": "#/$defs/stage"},
        "shot_transcript_links": {"$ref": "#/$defs/stage"},
        "scenes": {"$ref": "#/$defs/stage"},
        "scene_transcript_links": {"$ref": "#/$defs/stage"},
        "scene_summaries": {"$ref": "#/$defs/stage"},
        "package": {"$ref": "#/$defs/stage"},
        "sync": {"$ref": "#/$defs/stage"}
      },
      "additionalProperties": false
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": [
        "stage",
        "status",
        "input_fingerprint",
        "config_hash",
        "model",
        "prompt_version",
        "schema_version",
        "output_checksums",
        "completed_at",
        "error"
      ],
      "properties": {
        "stage": {
          "enum": [
            "shots",
            "keyframes",
            "asr",
            "ocr",
            "shot_captions",
            "shot_transcript_links",
            "scenes",
            "scene_transcript_links",
            "scene_summaries",
            "package",
            "sync"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "running",
            "complete",
            "invalidated",
            "failed_retryable",
            "failed_terminal"
          ]
        },
        "input_fingerprint": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {
          "type": "object",
          "required": ["model_id", "model_revision"],
          "properties": {
            "model_id": {"type": ["string", "null"]},
            "model_revision": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "prompt_version": {
          "type": ["string", "null"]
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "output_checksums": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "error": {
          "type": ["object", "null"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
