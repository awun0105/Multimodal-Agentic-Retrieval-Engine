{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "keyframes_v4",
  "type": "object",
  "required": [
    "keyframe_id",
    "video_id",
    "frame_id",
    "timestamp_sec",
    "shot_id",
    "cut_segment_id",
    "selection_reason",
    "is_representative",
    "keyframe_ref",
    "thumbnail_ref"
  ],
  "properties": {
    "keyframe_id": {
      "type": "string",
      "pattern": "^.+:[0-9]+$"
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "frame_id": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp_sec": {
      "type": "number",
      "minimum": 0
    },
    "shot_id": {
      "type": "string",
      "pattern": "^.+_SH[0-9]{5}$"
    },
    "cut_segment_id": {
      "type": "string",
      "pattern": "^.+_CS[0-9]{5}$"
    },
    "selection_reason": {
      "enum": [
        "shot_start",
        "visual_change"
      ]
    },
    "is_representative": {
      "type": "boolean",
      "description": "Exactly one true per shot; the keyframe used for the shot caption."
    },
    "keyframe_ref": {
      "type": "string",
      "pattern": "^keyframes/[^/]+/[^/]+_f[0-9]{7}\\.(jpg|webp)$"
    },
    "thumbnail_ref": {
      "type": "string",
      "pattern": "^thumbnails/[^/]+/[^/]+_f[0-9]{7}\\.webp$"
    }
  },
  "additionalProperties": false,
  "description": "keyframe_id is {video_id}:{frame_id}; timestamp_sec is the decoded-timeline pts of frame_id (ADR 0017). keyframe_ref ends in .jpg inside a worker package and .webp inside the runtime release (ADR 0025)."
}
