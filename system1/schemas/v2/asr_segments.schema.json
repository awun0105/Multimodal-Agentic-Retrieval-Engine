{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asr_segments_v2",
  "type": "object",
  "required": [
    "video_id",
    "start_sec",
    "end_sec",
    "text"
  ],
  "properties": {
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "start_sec": {
      "type": "number",
      "minimum": 0
    },
    "end_sec": {
      "type": "number",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "description": "One ChunkFormer segment. Empty when the video has no speech or ASR failed (stage status empty or failed)."
}
