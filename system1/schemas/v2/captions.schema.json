{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "captions_v2",
  "type": "object",
  "required": [
    "shot_id",
    "keyframe_id",
    "caption",
    "objects",
    "actions",
    "visible_text",
    "problems"
  ],
  "properties": {
    "shot_id": {
      "type": "string",
      "pattern": "^.+_SH[0-9]{5}$"
    },
    "keyframe_id": {
      "type": "string",
      "pattern": "^.+:[0-9]+$"
    },
    "caption": {
      "type": "string"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visible_text": {
      "type": "string"
    },
    "problems": {
      "type": "array",
      "items": {
        "enum": [
          "invalid_json",
          "prompt_echo",
          "repetition_loop",
          "empty",
          "generic"
        ]
      }
    }
  },
  "additionalProperties": false,
  "description": "One row per shot from the caption pass (ADR 0025), Vietnamese. A row with non-empty problems has no caption document. Lives in the caption package, not the worker package."
}
