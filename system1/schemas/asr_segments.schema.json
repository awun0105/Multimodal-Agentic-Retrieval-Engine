{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asr_segments_v1",
  "type": "object",
  "required": ["asr_segment_id", "video_id", "start_sec", "end_sec", "start_frame", "end_frame", "text", "language", "confidence", "avg_logprob", "no_speech_prob", "provider", "model_name", "model_version", "status"],
  "properties": {
    "asr_segment_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "start_sec": {"type": "number", "minimum": 0},
    "end_sec": {"type": "number", "exclusiveMinimum": 0},
    "start_frame": {"type": ["integer", "null"], "minimum": 0},
    "end_frame": {"type": ["integer", "null"], "minimum": 1},
    "text": {"type": "string", "minLength": 1},
    "language": {"type": ["string", "null"]},
    "confidence": {"type": ["number", "null"]},
    "avg_logprob": {"type": ["number", "null"]},
    "no_speech_prob": {"type": ["number", "null"]},
    "provider": {"const": "faster_whisper"},
    "model_name": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "status": {"const": "pass"}
  },
  "additionalProperties": false
}
