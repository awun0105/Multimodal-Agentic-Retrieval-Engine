{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ocr_v2",
  "type": "object",
  "required": [
    "ocr_id",
    "video_id",
    "keyframe_id",
    "shot_id",
    "frame_id",
    "text",
    "raw_text",
    "provider",
    "model_name",
    "model_version",
    "confidence",
    "status"
  ],
  "properties": {
    "ocr_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "keyframe_id": {"type": "string", "minLength": 1},
    "shot_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "integer", "minimum": 0},
    "text": {"type": "string"},
    "raw_text": {"type": "string"},
    "provider": {"type": "string", "minLength": 1},
    "model_name": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "language": {"type": "string"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "status": {"enum": ["pass", "empty", "failed"]}
  },
  "additionalProperties": true
}
