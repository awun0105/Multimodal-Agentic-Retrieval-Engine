{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scene_partition_review_candidate_v1",
  "type": "object",
  "required": ["schema_version", "candidate_fingerprint", "release_id", "video_id", "scenes_input_fingerprint", "scenes_stage_config_hash", "grouping_version", "decisions", "scenes", "initial_quality", "final_quality", "grouping_metadata", "created_at"],
  "properties": {
    "schema_version": {"const": "scene_partition_review_candidate_v1"},
    "candidate_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "scenes_input_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenes_stage_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "grouping_version": {"const": "scene_grouping_v4"},
    "decisions": {"type": "array", "items": {"type": "object"}},
    "scenes": {"type": "array", "items": {"type": "object"}},
    "initial_quality": {"type": "object"},
    "final_quality": {"type": "object"},
    "grouping_metadata": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
