{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scenes_v2",
  "type": "object",
  "required": ["scene_id", "video_id", "scene_index", "start_shot_id", "end_shot_id", "start_frame", "end_frame", "start_sec", "end_sec", "duration_sec", "frame_count", "shot_count", "keyframe_count", "scene_type", "grouping_method", "grouping_version", "confidence", "boundary_convention", "status"],
  "properties": {
    "scene_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "scene_index": {"type": "integer", "minimum": 0},
    "start_shot_id": {"type": "string", "minLength": 1},
    "end_shot_id": {"type": "string", "minLength": 1},
    "start_frame": {"type": "integer", "minimum": 0},
    "end_frame": {"type": "integer", "minimum": 1},
    "start_sec": {"type": "number", "minimum": 0},
    "end_sec": {"type": "number", "exclusiveMinimum": 0},
    "duration_sec": {"type": "number", "minimum": 0},
    "frame_count": {"type": "integer", "minimum": 1},
    "shot_count": {"type": "integer", "minimum": 1},
    "keyframe_count": {"type": "integer", "minimum": 0},
    "scene_type": {"const": "semantic"},
    "grouping_method": {"const": "multimodal_context_focus"},
    "grouping_version": {"const": "scene_grouping_v2"},
    "confidence": {"type": "null"},
    "boundary_convention": {"const": "[start_frame, end_frame)"},
    "status": {"const": "pass"}
  },
  "additionalProperties": false
}
