{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "keyframes_v3",
  "type": "object",
  "required": ["keyframe_id", "video_id", "frame_id", "timestamp_sec", "shot_id", "scene_id", "keyframe_role", "quality_score", "is_representative", "selection_reason", "keyframe_ref", "thumbnail_ref", "status"],
  "properties": {
    "keyframe_id": {"type": "string", "pattern": "^.+:[0-9]+$"},
    "video_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "integer", "minimum": 0},
    "timestamp_sec": {"type": "number", "minimum": 0},
    "shot_id": {"type": "string", "minLength": 1},
    "scene_id": {"type": ["string", "null"]},
    "keyframe_role": {"enum": ["early", "middle", "late", "supplemental"]},
    "quality_score": {"type": "number", "minimum": 0},
    "is_representative": {"type": "boolean"},
    "selection_reason": {"type": "string", "minLength": 1},
    "keyframe_ref": {"type": "string", "minLength": 1},
    "thumbnail_ref": {"type": "string", "minLength": 1},
    "status": {"const": "pass"}
  },
  "allOf": [
    {
      "if": {"properties": {"keyframe_role": {"const": "supplemental"}}},
      "then": {"properties": {"is_representative": {"const": false}}}
    }
  ],
  "additionalProperties": false
}
